<% content_for(:title) { "Supplies — Upkeep" } %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">Supplies</h1>

  <% if @supplies.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Supply</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase hidden sm:table-cell">Equipment</th>
            <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase">Stock</th>
            <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Buy</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @supplies.each do |supply| %>
            <tr class="<%= 'bg-red-50' if supply.low_stock? %>">
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-gray-900"><%= supply.name %></div>
                <div class="text-xs text-gray-500 sm:hidden">
                  <%= supply.maintenance_task.equipment.area.name %> &rsaquo; <%= supply.maintenance_task.equipment.name %>
                </div>
                <% if supply.notes.present? %>
                  <div class="text-xs text-gray-500 mt-0.5"><%= supply.notes %></div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 hidden sm:table-cell">
                <%= link_to equipment_path(supply.maintenance_task.equipment), class: "hover:text-blue-600" do %>
                  <%= supply.maintenance_task.equipment.area.name %> &rsaquo; <%= supply.maintenance_task.equipment.name %>
                <% end %>
                <div class="text-xs text-gray-400">Task: <%= supply.maintenance_task.name %></div>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-sm font-medium"><%= supply.quantity_on_hand %></span>
                <span class="text-xs text-gray-400">/ <%= supply.quantity_per_use %></span>
                <div class="mt-0.5"><%= stock_badge(supply) %></div>
              </td>
              <td class="px-4 py-3 text-right">
                <% if supply.purchase_url.present? %>
                  <%= link_to "Buy →", supply.purchase_url, target: "_blank", rel: "noopener", class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
                <% end %>
                <% if supply.unit_price.present? %>
                  <div class="text-xs text-gray-400 mt-0.5">$<%= number_with_precision(supply.unit_price, precision: 2) %></div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
      <p class="text-gray-500">No supplies tracked yet.</p>
    </div>
  <% end %>
</div>
