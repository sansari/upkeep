<% content_for(:title) { "#{@area.name} — Upkeep" } %>

<div class="space-y-6">
  <div class="flex items-center gap-2">
    <%= link_to "← Areas", areas_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900">
    <span class="mr-1"><%= @area.icon %></span> <%= @area.name %>
  </h1>

  <% if @equipment.any? %>
    <div class="space-y-4">
      <% @equipment.each do |equip| %>
        <% summary = equip.status_summary %>
        <%= link_to equipment_path(equip), class: "block bg-white rounded-lg shadow-sm border border-gray-200 p-4 hover:border-blue-300 hover:shadow transition" do %>
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-medium text-gray-900"><%= equip.name %></h2>
              <% if equip.description.present? %>
                <p class="text-sm text-gray-500 mt-0.5"><%= truncate(equip.description, length: 80) %></p>
              <% end %>
              <p class="text-xs text-gray-400 mt-1"><%= equip.maintenance_tasks.count %> <%= "task".pluralize(equip.maintenance_tasks.count) %></p>
            </div>
            <div class="text-right space-y-1">
              <% if summary[:overdue] > 0 %>
                <div class="text-xs text-red-600 font-medium"><%= summary[:overdue] %> overdue</div>
              <% end %>
              <% if summary[:due_soon] > 0 %>
                <div class="text-xs text-yellow-600 font-medium"><%= summary[:due_soon] %> due soon</div>
              <% end %>
              <% if summary[:upcoming] > 0 %>
                <div class="text-xs text-green-600"><%= summary[:upcoming] %> upcoming</div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
      <p class="text-gray-500">No equipment in this area yet.</p>
    </div>
  <% end %>
</div>
