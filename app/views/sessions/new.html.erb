<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <div class="text-5xl mb-3" aria-hidden="true">🏠</div>
    <h1 class="text-2xl font-bold text-gray-900">Upkeep</h1>
    <p class="mt-2 text-sm text-gray-600">Enter your password to continue.</p>
  </div>

  <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
    <% if alert.present? %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <% if notice.present? %>
      <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm">
        <%= notice %>
      </div>
    <% end %>

    <%= form_with url: session_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.password_field :password,
          required: true,
          autofocus: true,
          autocomplete: "current-password",
          class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= form.submit "Sign in", class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </div>
</div>
