<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "Upkeep" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Upkeep">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-controller="badge" data-badge-vapid-public-key-value="<%= Rails.application.credentials.vapid[:public_key] %>">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex justify-between h-14">
          <div class="flex items-center space-x-6">
            <%= link_to root_path, class: "text-lg font-bold text-gray-900 hover:text-blue-600" do %>
              🏠 Upkeep
            <% end %>
            <%= link_to "Areas", areas_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "Supplies", supplies_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "Log", log_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
      <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm flex items-center justify-between"
           style="display: none;"
           data-badge-target="permissionBanner">
        <span class="text-blue-800">Enable notifications to show a badge on the app icon when tasks are due.</span>
        <div class="flex items-center gap-2 ml-4 shrink-0">
          <button data-action="badge#requestPermission"
                  class="px-3 py-1 bg-blue-600 text-white rounded text-xs font-medium hover:bg-blue-700">
            Enable
          </button>
          <button data-action="badge#dismissBanner"
                  class="px-3 py-1 text-blue-600 text-xs font-medium hover:text-blue-800">
            Not now
          </button>
        </div>
      </div>

      <% if notice.present? %>
        <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm">
          <%= notice %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
